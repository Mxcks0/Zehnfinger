rules_version = '2';

// Sicherheitsregeln für Zehnfinger.
// Einfügen in der Firebase-Konsole: Firestore Database → Regeln → alles ersetzen → Veröffentlichen.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid)  { return signedIn() && request.auth.uid == uid; }
    // Entwickler: wer ein Dokument admins/<eigene UID> hat (nur in der Konsole anlegbar)
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Jeder darf nur nachsehen, ob er selbst Admin ist. Schreiben geht nur über die Konsole.
    match /admins/{uid} {
      allow read: if isMe(uid);
    }

    // Öffentliches Profil: Name, Level, Statistiken, Freundesliste, Liga, Team, Turnier, Herausforderungen.
    // Lesen dürfen alle angemeldeten Spieler (Freundessuche, Liga, Rangliste, Online-Zähler),
    // schreiben und löschen nur der Spieler selbst.
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isMe(uid);
    }

    // Community-Zusammenfassung (Weltrangliste, Wochen-Boss, Team-Liga …): ein einziges Dokument,
    // das angemeldete Spieler lesen und höchstens stündlich neu berechnen.
    match /stats/community {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.best is map
        && request.resource.data.t is number;
    }

    // Anonyme Gast-Statistik: jeder Gast darf nur sein eigenes Dokument anlegen und ändern,
    // und nur diese vier Felder. Lesen kann es nur der Entwickler.
    match /guests/{uid} {
      allow read: if isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['first', 'last', 'rounds', 'converted']);
    }

    // Kompletter Spielstand: nur der Spieler selbst.
    match /progress/{uid} {
      allow read, write: if isMe(uid);
    }

    // Live-Duelle: nur die beiden Beteiligten. Gastgeber und Gast lassen sich nachträglich nicht ändern.
    match /matches/{id} {
      function inMatch() {
        return signedIn() && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid);
      }
      allow read: if inMatch();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest is string
        && request.resource.data.guest != request.auth.uid;
      allow update: if inMatch()
        && request.resource.data.host == resource.data.host
        && request.resource.data.guest == resource.data.guest;
    }

    // Feedback: angemeldete Spieler dürfen senden, lesen und erledigen nur Admins.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow read, delete: if isAdmin();
    }

    // Alles andere ist gesperrt.
  }
}
