rules_version = '2';

// Sicherheitsregeln für Zehnfinger.
// Einfügen in der Firebase-Konsole: Firestore Database → Regeln → alles ersetzen → Veröffentlichen.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid)  { return signedIn() && request.auth.uid == uid; }
    // Entwickler: wer ein Dokument admins/<eigene UID> hat (nur in der Konsole anlegbar)
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Jeder darf nur nachsehen, ob er selbst Admin ist. Schreiben geht nur über die Konsole.
    match /admins/{uid} {
      allow read: if isMe(uid);
    }

    // ---------- Schutz gegen Schummeln ----------
    // Gesperrte Spieler (Eintrag in banned/<uid>, nur vom Entwickler anlegbar) können nichts mehr speichern.
    function notBanned(uid) { return !exists(/databases/$(database)/documents/banned/$(uid)); }
    // So viele XP braucht man für ein Level (wie im Spiel: 120, 180, 240 … pro Stufe)
    function xpFor(lv) { return 120 * (lv - 1) + 30 * (lv - 1) * (lv - 2); }
    // Passen Level, XP und Prestige zusammen, und steigen die XP nicht unmöglich schnell?
    // Erlaubt sind höchstens 3 XP pro Sekunde seit der letzten XP-Steigerung (xpAt) und maximal 20.000 auf einmal.
    // Zum Vergleich: Beim echten Spielen gibt es etwa 0,5 bis 1 XP pro Sekunde.
    function plausible(n, o) {
      let s = n.get('stats', {});
      let lv = n.get('level', 1);
      let xp = s.get('xp', 0);
      let all = n.get('xpAll', xp);
      let pr = n.get('prestige', 0);
      let inc = all - o.get('xpAll', o.get('stats', {}).get('xp', 0));
      let since = o.get('xpAt', o.get('createdAt', null));
      return lv is number && lv >= 1 && lv <= 300
        && xp is number && xp >= xpFor(lv)
        && all is number && all >= xp
        && pr is number && pr >= 0 && all >= pr * 27840
        && n.get('rankLv', pr * 100 + lv) == pr * 100 + lv
        && (inc <= 0 || o.get('xpAll', null) == null   // alte Profile ohne Gesamt-XP: einmalig ohne Tempo-Grenze
            || (n.get('xpAt', null) == request.time && inc <= 20000
                && (since == null || inc * 1000 <= (request.time.toMillis() - since.toMillis()) * 3)));
    }

    // Wer gesperrt ist, darf das nur selbst lesen (damit das Spiel es anzeigen kann).
    match /banned/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Öffentliches Profil: Name, Level, Statistiken, Freundesliste, Liga, Team, Turnier, Herausforderungen.
    // Lesen dürfen alle angemeldeten Spieler (Freundessuche, Liga, Rangliste, Online-Zähler),
    // schreiben nur der Spieler selbst – und nur mit glaubwürdigen Werten.
    // Der Entwickler darf nur die Markierung „banned“ setzen oder entfernen.
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && notBanned(uid)
        && plausible(request.resource.data, {})
        && request.resource.data.get('xpAll', request.resource.data.get('stats', {}).get('xp', 0)) <= 2000;
      allow update: if (isMe(uid) && notBanned(uid) && !resource.data.get('banned', false)
          && plausible(request.resource.data, resource.data))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned']));
      allow delete: if isMe(uid) && notBanned(uid);
    }

    // Community-Zusammenfassung (Weltrangliste, Wochen-Boss, Team-Liga …): ein einziges Dokument,
    // das angemeldete Spieler lesen und höchstens stündlich neu berechnen (bei Wochenwechsel sofort).
    // Der Entwickler darf es jederzeit neu berechnen, z. B. direkt nach dem Sperren eines Schummlers.
    match /stats/community {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.best is map
        && request.resource.data.t is number
        && request.resource.data.t <= request.time.toMillis() + 120000
        && (isAdmin() || resource == null
            || resource.data.get('t', 0) < request.time.toMillis() - 3000000
            || resource.data.get('k', '') != request.resource.data.get('k', '')
            || resource.data.get('v', 0) != request.resource.data.get('v', 0));
    }

    // Anonyme Gast-Statistik: jeder Gast darf nur sein eigenes Dokument anlegen und ändern,
    // und nur diese vier Felder. Lesen kann es nur der Entwickler.
    match /guests/{uid} {
      allow read: if isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['first', 'last', 'rounds', 'converted']);
    }

    // Kompletter Spielstand: nur der Spieler selbst.
    match /progress/{uid} {
      allow read, write: if isMe(uid);
    }

    // Live-Duelle: nur die beiden Beteiligten. Gastgeber und Gast lassen sich nachträglich nicht ändern.
    match /matches/{id} {
      function inMatch() {
        return signedIn() && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid);
      }
      allow read: if inMatch();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest is string
        && request.resource.data.guest != request.auth.uid;
      allow update: if inMatch()
        && request.resource.data.host == resource.data.host
        && request.resource.data.guest == resource.data.guest;
    }

    // Feedback: angemeldete Spieler dürfen senden, lesen und erledigen nur Admins.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow read, delete: if isAdmin();
    }

    // Alles andere ist gesperrt.
  }
}
